# Build a local source package: make dist && cd dist && makepkg -si
pkgname=calstack
pkgver=0.1.0
pkgrel=1
pkgdesc='A small native calendar strip for Wayland'
arch=('x86_64' 'aarch64')
url='https://github.com/reustle/calstack'
license=('MIT')
depends=('glibc' 'gcc-libs' 'fontconfig' 'xdg-utils')
optdepends=(
  'gtk4: graphical settings window'
  'python-gobject: graphical settings window'
  'glib2: theme and font detection outside Omarchy'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --workspace --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/calstack "$pkgdir/usr/bin/calstack"
  install -Dm644 packaging/calstack.desktop "$pkgdir/usr/share/applications/calstack.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/calstack/LICENSE"
}
